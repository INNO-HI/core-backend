# docker-compose 용 환경변수 — .env 로 복사해 값을 채운다.
# core 서비스의 DATABASE_URL 은 아래 POSTGRES_* 로 자동 구성된다.

POSTGRES_USER=safehi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=safehi_dashboard

# JWT — 프로덕션에서는 반드시 무작위 값으로 교체
JWT_SECRET=change-me-random-secret
JWT_EXPIRES_IN=7d

# 초기 관리자 계정 (프로덕션에서 ADMIN_PASSWORD 필수 — 없으면 서버가 종료된다)
ADMIN_EMAIL=admin@safehi.kr
ADMIN_PASSWORD=change-me-admin-password

# 웹 대시보드 origin (쉼표 구분)
CORS_ORIGINS=https://dashboard.safe-hi.xyz,http://localhost:3000

# 메일 (미설정 시 인증코드/재설정 토큰이 서버 로그로만 출력됨 — 프로덕션 필수)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="안심하이 <no-reply@safe-hi.xyz>"

# 인증 rate limit 예외 IP (쉼표 구분, 선택)
# AUTH_RATELIMIT_SKIP_IPS=
