// ============================================================
// SafeHi Dashboard – Prisma Schema
// PostgreSQL + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 사용자 / 인증
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          String   @default("user") // user(legacy) | admin(legacy) | master | institution | caregiver
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 소속 기관 (BACKEND_REQUEST §8)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // 계정별 권한 조정 (PERMISSIONS.md — 실제 권한 = rolePreset + grants − revokes)
  capabilityGrants Json? // { "grants": string[], "revokes": string[] }

  // 운영 관리 (마스터 콘솔)
  isActive       Boolean   @default(true) // 정지된 계정은 로그인 불가
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0) // 올리면 기존 토큰 전부 무효 (세션 강제 종료)

  feedbacks     Feedback[]
  memos         Memo[]
  managers      Manager[]
  recipients    Recipient[]
  careLogs      CareLog[]
  visits        Visit[]
  ownedMemos    Memo[]         @relation("MemoOwner")
  dashboardKpis DashboardKPI[]
  notifications Notification[]

  @@map("users")
}

// ============================================================
// 돌봄 센터  (전역 reference data — 모든 계정 공유)
// ============================================================

model Center {
  id   String @id @default(cuid())
  name String @unique

  // 센터는 기관 소속이다 (무소속은 옛 시드 잔재 — 콘솔에서 정리)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  managers Manager[]
  careLogs CareLog[]

  @@map("centers")
}

// ============================================================
// 동 (행정 구역) (전역 reference data — 모든 계정 공유)
// ============================================================

model Dong {
  id   String @id @default(cuid())
  name String @unique

  managerDongs ManagerDong[]
  recipients   Recipient[]

  @@map("dongs")
}

// ============================================================
// 매니저 (돌봄 관리사)
// ============================================================

model Manager {
  id        String    @id @default(cuid())
  name      String
  gender    String // male | female
  phone     String?
  email     String?
  status    String    @default("active") // active | leave | retired
  startDate DateTime?
  centerId  String?
  center    Center?   @relation(fields: [centerId], references: [id], onDelete: Restrict)

  // 실무자 계정 연결 — caregiver 로그인 계정과 매니저 레코드를 잇는다.
  // 서버 스코핑(§5 "배정 범위를 서버에서 막아야 한다")의 기준점.
  userId String? @unique

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recipientCount Int @default(0)
  monthlyVisits  Int @default(0)

  assignedDongs ManagerDong[]
  recipients    Recipient[]
  careLogs      CareLog[]
  visits        Visit[]
  tasks         Task[]

  @@index([centerId])
  @@index([ownerId])
  @@map("managers")
}

model ManagerDong {
  managerId String
  dongId    String
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  dong      Dong    @relation(fields: [dongId], references: [id], onDelete: Cascade)

  @@id([managerId, dongId])
  @@map("manager_dongs")
}

// ============================================================
// 대상자 (어르신)
// ============================================================

model Recipient {
  id            String    @id @default(cuid())
  name          String
  age           Int
  gender        String // male | female
  status        String    @default("normal") // normal | caution | urgent | unvisited
  address       String?
  dongId        String?
  dong          Dong?     @relation(fields: [dongId], references: [id], onDelete: SetNull)
  phone         String?
  careStartDate DateTime?

  // BACKEND_DB_SPEC.md §3.1 확장 필드
  birthDate     DateTime?
  livingAlone   Boolean?
  guardianName  String?
  guardianPhone String?
  addressDetail String?

  managerId String?
  manager   Manager? @relation(fields: [managerId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  healthInfo       Json? // { diseases, medications, notes }
  emergencyContact Json? // { name, relationship, phone }

  visitCount    Int       @default(0)
  lastVisitDate DateTime?
  createdAt     DateTime  @default(now())

  careLogs              CareLog[]
  visits                Visit[]
  memos                 Memo[]
  policyRecommendations RecipientPolicy[]
  consents              Consent[]
  tasks                 Task[]
  riskQueueItems        RiskQueue[]

  @@index([managerId])
  @@index([dongId])
  @@index([ownerId])
  @@map("recipients")
}

// ============================================================
// 돌봄 일지 (Care Log)
// ============================================================

model CareLog {
  id        String   @id @default(cuid())
  status    String   @default("pending") // draft | submitted | in_review | pending | urgent | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  managerId String
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  centerId String?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  visitDate     DateTime
  visitType     String?  @default("visit") // visit | call
  visitLocation String?

  careContent         Json? // { healthStatus, mealStatus, emotionalStatus, livingEnvironment }
  careContentBlocks   Json? // [{ title, content }]
  requiredActions     Json? // [{ id, priority, content }]
  recommendedPolicies Json? // [{ id, name, organization, schedule }]

  notes           String?
  photos          Json? // [url, ...]
  rejectionReason String?

  // BACKEND_DB_SPEC.md §3.4 확장 필드
  // 앱 적재 경로(POST /care-logs)에서는 confirmedById·confirmedAt 필수 —
  // 사람이 확인하지 않은 기록은 만들어지지 않는다. (기존 시드 행 때문에 DB 레벨은 nullable)
  mode           String? // liveRecording | postVoiceMemo
  transcript     String? // 마스킹된 텍스트. 음성 원본을 받는 컬럼은 만들지 않는다
  summary        String?
  sessionNo      Int?
  elapsedSeconds Int? // 실측. 못 쟀으면 null — 기본값을 넣지 않는다
  confirmedById  String?
  confirmedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?

  feedbacks      Feedback[]
  visit          Visit?
  sections       CareLogSection[]
  riskAssessment RiskAssessment?
  task           Task?

  @@index([recipientId, visitDate(sort: Desc)])
  @@index([managerId])
  @@index([ownerId, status])
  @@index([ownerId])
  @@map("care_logs")
}

// ============================================================
// AI 정리본 구획 (care_log_sections) — BACKEND_DB_SPEC.md §3.5
// kind 는 앱의 CareRecordSectionKind 와 1:1
// ============================================================

model CareLogSection {
  id        String  @id @default(cuid())
  careLogId String
  careLog   CareLog @relation(fields: [careLogId], references: [id], onDelete: Cascade)
  kind      String // log | notable | risk | nextVisit | followUp | workerInput
  title     String
  body      Json // string[] (불릿)
  sortOrder Int

  @@index([careLogId])
  @@map("care_log_sections")
}

// ============================================================
// 등급 판정 (risk_assessments) — BACKEND_DB_SPEC.md §3.6
// 등급은 LLM이 아니라 규칙 코드가 정한다. engine_version 으로 재현 가능해야 한다.
// ============================================================

model RiskAssessment {
  id               String   @id @default(cuid())
  careLogId        String   @unique
  careLog          CareLog  @relation(fields: [careLogId], references: [id], onDelete: Cascade)
  grade            String // observe | caution | alert | urgent
  workerGrade      String? // 종사자가 현장에서 고른 값 (하한으로만 사용)
  escalated        Boolean  @default(false)
  conflictResolved Boolean  @default(false)
  rationale        String
  engineVersion    String
  createdAt        DateTime @default(now())

  evidence   RiskEvidence[]
  queueEntry RiskQueue?

  @@map("risk_assessments")
}

// ============================================================
// 판정 근거 (risk_evidence) — BACKEND_DB_SPEC.md §3.7
// span 이 없을 때 신호 이름을 대신 넣지 않는다
// ============================================================

model RiskEvidence {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  signal       String
  span         String? // 상담 원문 인용. worker_tag 출처면 null
  grade        String
  source       String // transcript | worker_tag

  @@index([assessmentId])
  @@map("risk_evidence")
}

// ============================================================
// 위기 큐 (risk_queue) — BACKEND_DB_SPEC.md §3.8
// 경보(24h)·긴급(4h)만 들어온다. 시간이 지나도 자동 삭제되지 않는다.
// ============================================================

model RiskQueue {
  id               String         @id @default(cuid())
  assessmentId     String         @unique
  assessment       RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  recipientId      String
  recipient        Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  ownerId          String
  grade            String // alert | urgent
  raisedAt         DateTime
  dueAt            DateTime // raised_at + 등급별 시한 (저장해 둔다 — 소급 방지)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  ackNote          String?
  createdAt        DateTime       @default(now())

  @@index([ownerId, acknowledgedAt, dueAt])
  @@map("risk_queue")
}

// ============================================================
// 방문·전화 일정 (tasks) — BACKEND_DB_SPEC.md §3.3
// ============================================================

model Task {
  id          String    @id @default(cuid())
  type        String // visit | call
  startAt     DateTime
  durationMin Int       @default(60)
  status      String    @default("scheduled") // scheduled | done | canceled
  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  managerId   String
  manager     Manager   @relation(fields: [managerId], references: [id], onDelete: Cascade)
  careLogId   String?   @unique
  careLog     CareLog?  @relation(fields: [careLogId], references: [id], onDelete: SetNull)
  ownerId     String
  createdAt   DateTime  @default(now())

  @@index([managerId, startAt])
  @@index([ownerId, startAt])
  @@map("tasks")
}

// ============================================================
// 음성 수집 동의 (consents) — BACKEND_DB_SPEC.md §3.2
// 덮어쓰지 말고 이력으로 쌓는다. 앱에는 현재 유효한 값 하나(voiceConsent)만 내려간다.
// ============================================================

model Consent {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  voiceConsent Boolean
  grantedAt    DateTime  @default(now())
  grantedById  String // 기관 담당자 (users.id)
  revokedAt    DateTime?
  documentUrl  String? // 서면 동의서 스캔 등
  note         String?
  ownerId      String
  createdAt    DateTime  @default(now())

  @@index([recipientId])
  @@index([ownerId])
  @@map("consents")
}

// ============================================================
// 감사 로그 (audit_logs) — BACKEND_DB_SPEC.md §3.10
// 최소: 동의 등록·철회, 위기 큐 확인 처리, 기록 생성·승인
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // login | care_log.create | care_log.approve | risk.ack | consent.grant | consent.revoke …
  targetType String?
  targetId   String?
  payload    Json?
  ip         String?
  ownerId    String?
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// 피드백 (돌봄 일지 코멘트)
// careLog.ownerId 를 통해 격리됨 (별도 ownerId 불필요)
// ============================================================

model Feedback {
  id         String   @id @default(cuid())
  content    String
  authorRole String?
  createdAt  DateTime @default(now())

  careLogId String
  careLog   CareLog @relation(fields: [careLogId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([careLogId])
  @@map("feedbacks")
}

// ============================================================
// 방문 기록 (Visit)
// ============================================================

model Visit {
  id        String   @id @default(cuid())
  visitDate DateTime
  visitType String   @default("visit") // visit | call
  summary   String?
  createdAt DateTime @default(now())

  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  managerId String
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  careLogId String?  @unique
  careLog   CareLog? @relation(fields: [careLogId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([managerId])
  @@index([ownerId])
  @@map("visits")
}

// ============================================================
// 메모
// ownerId = 메모를 보유한 워크스페이스 소유자 (대상자의 owner)
// authorId = 실제 작성자 (User)
// ============================================================

model Memo {
  id        String   @id @default(cuid())
  content   String
  type      String?  @default("normal") // normal | warning | important
  createdAt DateTime @default(now())

  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  ownerId String
  owner   User   @relation("MemoOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([ownerId])
  @@map("memos")
}

// ============================================================
// 정책 (복지 정책) — 전역 reference data
// ============================================================

model Policy {
  id                String  @id @default(cuid())
  name              String
  summary           String?
  applicationMethod String?
  details           Json?

  recipientPolicies RecipientPolicy[]

  @@map("policies")
}

// ============================================================
// 대상자-정책 연결 (대상자 ownerId 통해 격리)
// ============================================================

model RecipientPolicy {
  recipientId String
  policyId    String
  matchScore  Int      @default(0)
  createdAt   DateTime @default(now())

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@id([recipientId, policyId])
  @@map("recipient_policies")
}

// ============================================================
// 대시보드 KPI (집계 캐시) — 계정별
// ============================================================

model DashboardKPI {
  id              String   @id @default(cuid())
  date            DateTime @default(now()) @db.Date
  todayVisits     Int      @default(0)
  pendingReports  Int      @default(0)
  approvedCount   Int      @default(0)
  totalRecipients Int      @default(0)
  createdAt       DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([date, ownerId])
  @@index([ownerId])
  @@map("dashboard_kpi")
}

// ============================================================
// 복지 뉴스 (전역 reference data — 모든 계정 공유)
// ============================================================

model WelfareNews {
  id          String   @id @default(cuid())
  title       String
  description String
  tag         String?
  date        String
  createdAt   DateTime @default(now())

  @@map("welfare_news")
}

// ============================================================
// 공지사항 (전역 reference data — 모든 계정 공유)
// ============================================================

// ============================================================
// 기관 (BACKEND_REQUEST §8 — institutionCode 검증)
// 가입 시 4자리 코드로 소속 기관을 특정한다
// ============================================================

model Institution {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // 발급한 4자리 코드
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  users   User[]
  centers Center[]

  @@map("institutions")
}

// ============================================================
// 이메일 인증 코드 (BACKEND_REQUEST §2)
// 코드는 응답에 담지 않는다 — 메일로만 보낸다. 무작위 + 만료 + 시도 제한
// ============================================================

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("email_verifications")
}

// ============================================================
// 비밀번호 재설정 토큰 (BACKEND_REQUEST §9)
// 일회용 토큰을 메일로 보내고, 그 토큰과 함께 온 요청만 받는다
// ============================================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// 전역 런타임 설정 (점검 모드 등) — 마스터 콘솔에서 토글
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  date      String
  isNew     Boolean  @default(false)
  content   String? // 본문 (BACKEND_REQUEST §4 — 제목만 있으면 앱이 내용을 못 보여준다)
  createdAt DateTime @default(now())

  @@map("notices")
}

// ============================================================
// 알림 (Notification) — 계정별
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  content   String
  isUrgent  Boolean  @default(false)
  link      String?
  icon      String?  @default("info")
  kind      String? // status | welfare | notice (BACKEND_DB_SPEC.md §4.4 세 갈래)
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("notifications")
}
