# Core Backend System Configuration
# 실제 배포 시 이 파일을 .env 로 복사한 뒤 값을 채운다.

# -----------------------------------------------------------------------------
# Server (Node.js / Express)
# -----------------------------------------------------------------------------
CORE_PORT=4100
CORE_HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma) — 대시보드/앱의 모든 실데이터 저장소
# docker-compose 사용 시 core 서비스에 자동 주입된다.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://safehi:safehi_password@localhost:5432/safehi_dashboard?schema=public

# docker-compose 의 postgres 서비스가 쓰는 값 (repo 루트 .env)
POSTGRES_USER=safehi
POSTGRES_PASSWORD=safehi_password
POSTGRES_DB=safehi_dashboard

# true 면 DB 없이 InMemory 레포 사용 (일부 기능 제한 — 로컬 테스트 전용)
USE_INMEMORY=false

# -----------------------------------------------------------------------------
# Auth (JWT) — 프로덕션에서는 반드시 무작위 시크릿으로 교체
# -----------------------------------------------------------------------------
JWT_SECRET=safehi-dev-secret-change-me
JWT_EXPIRES_IN=7d

# 초기 관리자 계정 (첫 시드 시 생성; 프로덕션에서는 ADMIN_PASSWORD 필수)
ADMIN_EMAIL=admin@safehi.kr
ADMIN_PASSWORD=Admin1234!

# 인증 rate limit (15분 창)
AUTH_RATELIMIT_MAX=60
# 심사용 IP 예외 (쉼표 구분)
# AUTH_RATELIMIT_SKIP_IPS=

# -----------------------------------------------------------------------------
# Mail (SMTP) — 미설정 시 개발 모드: 인증코드/재설정 토큰을 서버 로그로만 출력
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="안심하이 <no-reply@safe-hi.xyz>"

# -----------------------------------------------------------------------------
# AI Server (Flask)
# -----------------------------------------------------------------------------
AI_HOST=127.0.0.1
AI_PORT=5000
# AI_BASE_URL=http://127.0.0.1:5000
AI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Prisma Studio (설정 페이지의 DB 콘솔 버튼) — 별도 프로세스로 띄운 주소
# -----------------------------------------------------------------------------
# PRISMA_STUDIO_URL=http://localhost:5555

# -----------------------------------------------------------------------------
# Legacy MySQL (양천 STT 리포트 경로 — /core/api/reports/*)
# -----------------------------------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=example
MYSQL_DATABASE=safe_hi
MYSQL_CONN_LIMIT=10

# -----------------------------------------------------------------------------
# Tenant / CORS
# -----------------------------------------------------------------------------
DEFAULT_TENANT=yangchun
# 웹 대시보드 origin (쉼표 구분, 여러 개 가능)
CORS_ORIGINS=http://localhost:3000
